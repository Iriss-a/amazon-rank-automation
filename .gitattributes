# Normalize line endings so Windows scripts and cross-platform sources coexist.
* text=auto

# Windows-native scripts: keep CRLF (double-click / PowerShell friendly)
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Everything else: LF
*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
